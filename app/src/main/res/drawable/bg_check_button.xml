<?xml version="1.0" encoding="utf-8"?>
<!-- Botão de concluir: círculo contornado (pendente) ou verde-limão preenchido (feito). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="@color/brand_lime" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/color_transparent" />
            <stroke
                android:width="@dimen/stroke_selected"
                android:color="@color/color_outline" />
        </shape>
    </item>
</selector>
