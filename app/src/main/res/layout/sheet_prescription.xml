<?xml version="1.0" encoding="utf-8"?>
<!-- Formulário da prescrição de um exercício (bottom sheet do editor de treino). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_xl">

        <TextView
            android:id="@+id/text_target"
            style="@style/AppTreino.Text.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Peitoral" />

        <TextView
            android:id="@+id/text_name"
            style="@style/AppTreino.Text.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Supino reto com barra" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_lg" />

        <!-- Séries e repetições (ou tempo, nos isométricos) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout_sets"
                style="@style/Widget.AppTreino.TextInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/field_sets">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_sets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <Space
                android:layout_width="@dimen/space_sm"
                android:layout_height="match_parent" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout_reps_min"
                style="@style/Widget.AppTreino.TextInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/field_reps_min">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_reps_min"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <Space
                android:id="@+id/space_reps"
                android:layout_width="@dimen/space_sm"
                android:layout_height="match_parent" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout_reps_max"
                style="@style/Widget.AppTreino.TextInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/field_reps_max">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_reps_max"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout_seconds"
                style="@style/Widget.AppTreino.TextInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:hint="@string/field_seconds"
                android:visibility="gone"
                app:suffixText="@string/unit_seconds">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_seconds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="3" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_md" />

        <!-- Carga e descanso -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout_load"
                style="@style/Widget.AppTreino.TextInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/field_load"
                app:suffixText="@string/unit_kg">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_load"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:digits="@string/digits_decimal"
                    android:inputType="numberDecimal"
                    android:maxLength="5" />
            </com.google.android.material.textfield.TextInputLayout>

            <Space
                android:layout_width="@dimen/space_sm"
                android:layout_height="match_parent" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout_rest"
                style="@style/Widget.AppTreino.TextInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/field_rest"
                app:suffixText="@string/unit_seconds">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_rest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="3" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_body_weight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:minHeight="@dimen/touch_target"
            android:text="@string/field_body_weight"
            android:textAppearance="@style/AppTreino.Text.Body" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/check_per_side"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:text="@string/field_per_side"
            android:textAppearance="@style/AppTreino.Text.Body" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_sm" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_layout_note"
            style="@style/Widget.AppTreino.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/field_coach_note_optional">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="200"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_xl" />

        <include
            android:id="@+id/buttons"
            layout="@layout/view_sheet_buttons" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
