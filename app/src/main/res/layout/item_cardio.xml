<?xml version="1.0" encoding="utf-8"?>
<!-- Card de uma atividade de cardio na aba "Hoje". -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_cardio"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_md">

        <FrameLayout
            android:layout_width="@dimen/avatar_medium"
            android:layout_height="@dimen/avatar_medium"
            android:background="@drawable/bg_circle_accent_soft">

            <ImageView
                android:id="@+id/image_cardio_type"
                android:layout_width="@dimen/icon_large"
                android:layout_height="@dimen/icon_large"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/color_accent"
                tools:src="@drawable/ic_cardio_run" />
        </FrameLayout>

        <Space
            android:layout_width="@dimen/space_md"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_cardio_name"
                style="@style/AppTreino.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Esteira" />

            <TextView
                android:id="@+id/text_cardio_summary"
                style="@style/AppTreino.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/color_text_primary"
                tools:text="15 min · Moderada" />

            <TextView
                android:id="@+id/text_cardio_note"
                style="@style/AppTreino.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="italic"
                android:visibility="gone"
                tools:text="Ao final do treino, em ritmo que ainda permita conversar."
                tools:visibility="visible" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/button_cardio_done"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_marginStart="@dimen/space_xs"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/image_cardio_done"
                android:layout_width="@dimen/check_button_size"
                android:layout_height="@dimen/check_button_size"
                android:layout_gravity="center"
                android:background="@drawable/bg_check_button"
                android:importantForAccessibility="no"
                android:padding="@dimen/check_icon_padding"
                android:src="@drawable/ic_check"
                app:tint="@color/selector_check_icon" />
        </FrameLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
