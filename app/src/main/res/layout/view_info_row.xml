<?xml version="1.0" encoding="utf-8"?>
<!-- Linha "rótulo ........ valor", reutilizada no card do plano (Perfil). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_target"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_lg"
    android:paddingEnd="@dimen/space_lg">

    <TextView
        android:id="@+id/text_row_label"
        style="@style/AppTreino.Text.BodySecondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        tools:text="Objetivo" />

    <TextView
        android:id="@+id/text_row_value"
        style="@style/AppTreino.Text.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Hipertrofia" />
</LinearLayout>
