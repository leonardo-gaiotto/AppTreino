<?xml version="1.0" encoding="utf-8"?>
<!-- Uma sessão no histórico do exercício: data, séries feitas e valor com tendência. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_md">

        <LinearLayout
            android:layout_width="@dimen/week_day_column_width"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_weekday"
                style="@style/AppTreino.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="SEG" />

            <TextView
                android:id="@+id/text_date"
                style="@style/AppTreino.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                tools:text="21/09" />
        </LinearLayout>

        <Space
            android:layout_width="@dimen/space_md"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/text_sets"
            style="@style/AppTreino.Text.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/color_text_primary"
            tools:text="10 × 40 kg · 10 × 40 kg · 9 × 40 kg · 8 × 40 kg" />

        <Space
            android:layout_width="@dimen/space_md"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/text_value"
            style="@style/AppTreino.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/space_xs"
            android:gravity="center_vertical"
            android:textStyle="bold"
            tools:text="40 kg" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
