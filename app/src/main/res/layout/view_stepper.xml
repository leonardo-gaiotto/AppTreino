<?xml version="1.0" encoding="utf-8"?>
<!-- Controle "− valor +" usado no registro das séries (repetições e carga). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_rounded_surface_variant"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/space_xxs">

    <ImageButton
        android:id="@+id/button_minus"
        android:layout_width="@dimen/stepper_button_size"
        android:layout_height="@dimen/stepper_button_size"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/space_sm"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_remove"
        app:tint="@color/color_text_primary"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_stepper_value"
            style="@style/AppTreino.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textStyle="bold"
            tools:text="10" />

        <TextView
            android:id="@+id/text_stepper_unit"
            style="@style/AppTreino.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="reps" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/button_plus"
        android:layout_width="@dimen/stepper_button_size"
        android:layout_height="@dimen/stepper_button_size"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/space_sm"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_add"
        app:tint="@color/color_text_primary"
        tools:ignore="ContentDescription" />
</LinearLayout>
