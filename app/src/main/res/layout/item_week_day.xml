<?xml version="1.0" encoding="utf-8"?>
<!-- Um dia da semana na aba "Semana". -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_day"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_lg">

        <!-- Coluna com o dia (SEG / 28) -->
        <LinearLayout
            android:layout_width="@dimen/week_day_column_width"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_day_short"
                style="@style/AppTreino.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="SEG" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_xs" />

            <TextView
                android:id="@+id/text_day_number"
                style="@style/AppTreino.Text.Title"
                android:layout_width="@dimen/avatar_medium"
                android:layout_height="@dimen/avatar_medium"
                android:gravity="center"
                android:textStyle="bold"
                tools:background="@drawable/bg_circle_accent"
                tools:text="28"
                tools:textColor="@color/color_on_accent" />
        </LinearLayout>

        <Space
            android:layout_width="@dimen/space_md"
            android:layout_height="match_parent" />

        <!-- Treino do dia e progresso -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_day_title"
                style="@style/AppTreino.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                tools:text="Treino A · Peito, ombros e tríceps" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_xxs" />

            <TextView
                android:id="@+id/text_day_detail"
                style="@style/AppTreino.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="7 exercícios · ~45 min" />

            <Space
                android:id="@+id/space_progress"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_sm" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_day"
                style="@style/Widget.AppTreino.ProgressIndicator.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                tools:progress="40" />
        </LinearLayout>

        <Space
            android:layout_width="@dimen/space_md"
            android:layout_height="match_parent" />

        <!-- Situação do dia -->
        <TextView
            android:id="@+id/text_status"
            style="@style/AppTreino.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/space_xs"
            android:gravity="center_vertical"
            tools:text="Hoje"
            tools:textColor="@color/color_accent" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
