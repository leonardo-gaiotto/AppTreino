<?xml version="1.0" encoding="utf-8"?>
<!-- Cardio no editor de treino: tocar para editar, X para remover. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_editor_cardio"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_xs"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_sm">

        <FrameLayout
            android:layout_width="@dimen/avatar_medium"
            android:layout_height="@dimen/avatar_medium"
            android:background="@drawable/bg_circle_accent_soft">

            <ImageView
                android:id="@+id/image_type"
                android:layout_width="@dimen/icon_large"
                android:layout_height="@dimen/icon_large"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/color_accent"
                tools:src="@drawable/ic_cardio_run" />
        </FrameLayout>

        <Space
            android:layout_width="@dimen/space_md"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_type"
                style="@style/AppTreino.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Esteira" />

            <TextView
                android:id="@+id/text_summary"
                style="@style/AppTreino.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="15 min · Moderada" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/button_remove"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/space_md"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            app:tint="@color/color_text_secondary"
            tools:ignore="ContentDescription" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
