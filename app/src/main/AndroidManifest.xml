<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Necessária para baixar as miniaturas dos vídeos do YouTube. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".AppTreinoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppTreino">

        <!-- Tela principal: usa o tema da splash screen, trocado pelo tema do app no onCreate. -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AppTreino.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Detalhe do exercício: aberta somente por Intent explícita de dentro do app. -->
        <activity
            android:name=".ui.exercise.ExerciseDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.main.MainActivity" />

        <!-- ===== Modo Coach: todas abertas por Intent explícita (não exportadas) ===== -->
        <activity
            android:name=".ui.students.StudentFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.dashboard.StudentDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".ui.dashboard.ExerciseHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".ui.editor.WorkoutEditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.editor.ExerciseCatalogActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
